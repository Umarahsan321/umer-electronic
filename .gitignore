# ==============================================================================
# Umer Electronics Monorepo — Git Ignore Configuration
# ==============================================================================

# Dependencies (Root, apps, and packages)
node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache (apps/web)
.next/
**/.next/
out/
**/out/
.open-next/
**/.open-next/

# Vite / SPA Build Outputs (apps/admin)
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Production & Build Artifacts
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo

# Turbopack & SWC Caches
.turbo/
**/.turbo/
.swc/
**/.swc/

# Environment Variables & Local Secret Files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*.local

# Logs & Debugging
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# Operating System Files
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Certificates & Security
*.pem

# Next.js TypeScript auto-generated definitions
next-env.d.ts
**/next-env.d.ts
